# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# When running with docker compose these values are supplied by
# docker-compose.yml, so .env is only needed if you run something directly on
# your Mac (for example pytest outside the containers).

# ---- Environment ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- Database ---------------------------------------------------------------
# Use "localhost" from your Mac; docker compose overrides this to "postgres".
DATABASE_URL=postgresql+psycopg://autods:autods@localhost:5432/autods

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Object storage ---------------------------------------------------------
# Local MinIO. On AWS, delete S3_ENDPOINT_URL entirely and delete the two
# credential lines so boto3 uses the EC2 instance's IAM role instead.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autods-artifacts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=200

# ---- LLM (Section 2) --------------------------------------------------------
# Left blank deliberately. Put your real key in .env, never here.
# LLM_API_KEY=
