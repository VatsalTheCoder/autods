# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# When running with docker compose these values are supplied by
# docker-compose.yml, so .env is only needed if you run something directly on
# your Mac (for example pytest outside the containers).

# ---- Environment ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- Database ---------------------------------------------------------------
# Use "localhost" from your Mac; docker compose overrides this to "postgres".
DATABASE_URL=postgresql+psycopg://autods:autods@localhost:5432/autods

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Object storage ---------------------------------------------------------
# Local MinIO. On AWS, delete S3_ENDPOINT_URL entirely and delete the two
# credential lines so boto3 uses the EC2 instance's IAM role instead.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autods-artifacts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=200

# ---- LLM: Google AI Studio (Section 2) --------------------------------------
# Left blank deliberately -- put your real key in .env, never here. When it is
# unset the real client refuses to start and the test suite falls back to the
# FakeLLM, so the suite stays green with no key and no network.
# GOOGLE_API_KEY=

# Model ids. The spec's "Gemma 4" names are UNVERIFIED (spec 6.3); override
# these with whatever the provider actually serves before going live.
LLM_MODEL_SMALL=gemma-3-4b-it
LLM_MODEL_LARGE=gemma-3-27b-it

# Free-tier rate limits, per tier. Also unverified -- confirm against live docs.
LLM_SMALL_RPM=30
LLM_SMALL_INPUT_TPM=15000
LLM_LARGE_RPM=30
LLM_LARGE_INPUT_TPM=15000

# Retries: schema re-asks vs. HTTP 429 backoff (separate budgets).
LLM_MAX_RETRIES=3
LLM_BACKOFF_RETRIES=5
LLM_REQUEST_TIMEOUT=60

# ---- Pipeline / modelling (Section 5) ---------------------------------------
# Cross-validation folds. Five is the spec's figure; lower it only for a demo
# dataset too small to give five stratified folds enough rows per class.
CV_FOLDS=5

# One seed for fold shuffling and the model, so a reported score is reproducible.
RANDOM_SEED=42

# Cleaning drops a column missing more often than this rather than imputing it.
MAX_NULL_COLUMN_RATE=0.6
