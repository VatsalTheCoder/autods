# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# When running with docker compose these values are supplied by
# docker-compose.yml, so .env is only needed if you run something directly on
# your Mac (for example pytest outside the containers).

# ---- Environment ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- Database ---------------------------------------------------------------
# Use "localhost" from your Mac; docker compose overrides this to "postgres".
DATABASE_URL=postgresql+psycopg://autods:autods@localhost:5432/autods

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Object storage ---------------------------------------------------------
# Local MinIO. On AWS, set S3_ENDPOINT_URL to the EMPTY STRING -- do not delete
# the line. The default in config.py is this MinIO URL, so an absent variable
# falls back to it and points production at a container that is not there. An
# empty value is the documented spelling of "use real AWS S3".
# Delete the two credential lines, though: with no key set, boto3 uses the EC2
# instance's IAM role, which is the point of attaching one.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autods-artifacts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---- Secrets Manager (AWS only) ---------------------------------------------
# Name of a Secrets Manager secret holding a JSON object of settings -- in
# practice google_api_key. Leave unset locally: unset means no boto3 call, no
# credentials needed, and no behaviour change at all.
# An environment variable takes precedence over the secret, so after rotating a
# key make sure nothing in the environment is still shadowing it.
# See docs/DEPLOYMENT.md.
# AWS_SECRETS_ID=autods/production

# ---- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=200

# ---- Modelling --------------------------------------------------------------
# How many rows reach model fitting; above this a planned sampling step
# subsamples, stratified by the target. 20,000 is ample for a balanced dataset.
# On a rare-event dataset it binds on *signal* rather than time -- preserving the
# ratio of a 0.13%-fraud dataset leaves ~26 positives in 20,000 rows -- so raise
# it when the minority class is what you care about.
MAX_MODELLING_ROWS=20000

# ---- LLM: Google AI Studio (Section 2) --------------------------------------
# Left blank deliberately -- put your real key in .env, never here. When it is
# unset the real client refuses to start and the test suite falls back to the
# FakeLLM, so the suite stays green with no key and no network.
# GOOGLE_API_KEY=

# Model ids, verified against live AI Studio on 2026-07-27. The spec's
# gemma-3-* names are gone (404) and today's smallest Gemma is a 26B MoE that
# takes ~42s on an agent prompt -- past the 60s timeout often enough that agents
# silently fall back to their deterministic path. Gemini flash-lite does the
# same work in ~1.6s. Override freely: these are settings precisely so a Gemma
# or self-hosted deployment needs no code change (spec 6.3).
LLM_MODEL_SMALL=gemini-3.1-flash-lite
LLM_MODEL_LARGE=gemini-3.5-flash

# The third tier is a different model *family*, not a third size. SMALL and
# LARGE are both Gemini and share an outage: a sweep on 2026-07-31 took eight
# 503s in one afternoon and stepping between them helped with none of it. Gemma
# runs on the same key, so this costs no extra secret. Re-measured that day on a
# critic-sized prompt: gemma-4-31b-it answered in 13.8-16.3s with valid JSON 4
# times in 4, while the 26B MoE above returns an empty body two times in three.
LLM_MODEL_FALLBACK=gemma-4-31b-it

# Free-tier rate limits, per tier. Also unverified -- confirm against live docs.
LLM_SMALL_RPM=30
LLM_SMALL_INPUT_TPM=15000
LLM_LARGE_RPM=30
LLM_LARGE_INPUT_TPM=15000
# The exception: these two were read off the live AI Studio quota dashboard for
# Gemma 4 31B on 2026-07-31, so they are measured rather than assumed.
LLM_FALLBACK_RPM=30
LLM_FALLBACK_INPUT_TPM=15000

# Retries: schema re-asks vs. HTTP 429 backoff (separate budgets).
LLM_MAX_RETRIES=3
LLM_BACKOFF_RETRIES=5
LLM_REQUEST_TIMEOUT=60

# ---- Pipeline / modelling (Section 5) ---------------------------------------
# Cross-validation folds. Five is the spec's figure; lower it only for a demo
# dataset too small to give five stratified folds enough rows per class.
CV_FOLDS=5

# One seed for fold shuffling and the model, so a reported score is reproducible.
RANDOM_SEED=42

# Cleaning drops a column missing more often than this rather than imputing it.
MAX_NULL_COLUMN_RATE=0.6

# ---- EDA & clustering (Section 6) -------------------------------------------
# The range of k the silhouette search tries when looking for natural groups.
CLUSTER_K_MIN=2
CLUSTER_K_MAX=8

# Above this many rows, k selection runs on a random sample (the silhouette
# curve settles long before every row is involved).
CLUSTER_SAMPLE_SIZE=5000

# Chart rendering. Legible on a laptop without producing megabyte PNGs.
PLOT_DPI=110
MAX_HEATMAP_COLUMNS=25
MAX_DISTRIBUTION_PLOTS=12

# ---- Public deployment -------------------------------------------------------
# Unset locally: with no value the Streamlit gate is invisible and the app
# behaves exactly as it always has. Set it before tunnelling and every page
# demands the key -- which is the only thing standing between a public URL and
# an app that has no user accounts. Only the UI is ever exposed; the API stays
# on the Docker network.
# AUTODS_ACCESS_TOKEN=
